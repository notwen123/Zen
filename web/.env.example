# Server-only (never prefix with NEXT_PUBLIC_). Demo keys - testnet only.
# ATTESTER_ECDSA_KEY signs purchase claims (registry) and refund attestations (VoidOracle).
ATTESTER_ECDSA_KEY=
ATTESTER_SALT=

# Simulated merchant POS (demo only, optional). Generate a fresh 32-byte seed; it MUST differ from the attester key.
# The attester only needs the public key.
MERCHANT_ED25519_SEED=
MERCHANT_ED25519_PUBLIC_KEY=

# Public: WalletConnect Cloud project id used by RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Testnet-only faucet wallet for new passkey accounts (/api/faucet). Server-side secret.
FAUCET_PRIVATE_KEY=
# Envio HyperIndex GraphQL endpoint (indexer/). Local: http://localhost:8080/v1/graphql
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
