# Server-only (never prefix with NEXT_PUBLIC_). Demo attester keys - testnet only.
ATTESTER_ED25519_SEED=
ATTESTER_ECDSA_KEY=
ATTESTER_SALT=

# Simulated merchant POS (demo only). Generate a fresh 32-byte seed; it MUST differ from the attester seed.
# The attester only needs the public key.
MERCHANT_ED25519_SEED=
MERCHANT_ED25519_PUBLIC_KEY=

# Public: WalletConnect Cloud project id used by RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
