# STOCKBACK - copy to .env, never commit .env.

# Target network (see config/networks.json). Demo deploys only run on 31337 / 46630 / 421614.
RPC_URL=https://rpc.testnet.chain.robinhood.com

# Dedicated testnet deploy key. Never a personal wallet.
DEPLOYER_PRIVATE_KEY=

# ECDSA attester address allowed by ECDSAAttestationVerifier (tools/attester.mjs signer).
ATTESTER_ADDRESS=
# Optional: deployed stylus/receipt-prover to use as the registry verifier instead of ECDSA.
STYLUS_VERIFIER=

# tools/attester.mjs (demo attester; keep secret, testnet only)
ATTESTER_ECDSA_KEY=
ATTESTER_ED25519_SEED=
ATTESTER_SALT=
