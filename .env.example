# Deployer for script/DeployZen.s.sol (never commit a real key; .env* is git-ignored)
DEPLOYER_PRIVATE_KEY=
# Monad testnet (chain 10143). Public endpoint from docs.monad.xyz; mainnet (143) is https://rpc.monad.xyz
RPC_URL=https://testnet-rpc.monad.xyz
# ECDSA attester that signs purchase claims (and, unless REFUND_ATTESTER is set, refund attestations)
ATTESTER_ADDRESS=
REFUND_ATTESTER=
# true = short labelled demo return windows (5-10 min); false = production defaults (14-30 days)
DEMO_WINDOWS=true
BUDGET_PER_BRAND=
